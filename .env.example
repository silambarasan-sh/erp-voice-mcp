# ERP Voice Agent - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Django Settings
DJANGO_SECRET_KEY=erp-voice-mcp-dummy-secret-key-for-hackathon-demo-only
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (SQLite)
DATABASE_NAME=db.sqlite3

# MCP Server Configuration
MCP_SERVER_NAME=erp-voice-agent
MCP_SERVER_VERSION=1.0.0
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PROTOCOL_VERSION=2025-11-25
MCP_STREAMABLE_HTTP_PATH=/mcp
